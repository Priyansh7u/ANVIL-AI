# ─── Required for persistence (optional for local demo) ─────────────────────
# MongoDB Atlas connection string. Without it ANVIL runs with an in-memory
# store (clearly labelled "ephemeral" in the UI) that resets on restart.
MONGODB_URI=

# ─── TinyFish (https://agent.tinyfish.ai/api-keys) ───────────────────────────
# Used server-side only by the research agent (Search + Fetch APIs).
TINYFISH_API_KEY=
# Set to "true" to also let the agent run TinyFish Agent (browser) tasks on
# official district sites. Agent runs consume TinyFish credits.
TINYFISH_AGENT_ENABLED=false

# ─── AI provider ─────────────────────────────────────────────────────────────
# Used to extract structured facts (with verbatim evidence quotes) from
# official pages, and to write labelled checklists. Optional: without it the
# agent falls back to pattern extraction and template checklists.
#
# Option A — Anthropic (Claude):
#   AI_PROVIDER=anthropic
#   AI_MODEL=claude-haiku-5-5
# Option B — any OpenAI-compatible Chat Completions API:
#   AI_PROVIDER=openai-compatible
#   OpenAI:  AI_BASE_URL=https://api.openai.com/v1
#   Gemini:  AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   Groq:    AI_BASE_URL=https://api.groq.com/openai/v1
#   AI_MODEL=<a model name from that provider's docs>
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=claude-haiku-5-5
AI_BASE_URL=

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Contact string sent in the User-Agent to OpenStreetMap Nominatim, as its usage policy requires.
GEOCODER_CONTACT=you@example.com

# ─── Maps ────────────────────────────────────────────────────────────────────
# Raster tile template. The default is the OSM standard tile server, which is
# fine for a demo but NOT for heavy production traffic (see OSM tile policy).
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_TILE_ATTRIBUTION=© OpenStreetMap contributors
# Routing provider base URL (OSRM HTTP API). Default is the public demo server.
ROUTING_BASE_URL=https://router.project-osrm.org

# ─── Web push (reserved) ─────────────────────────────────────────────────────
# Not used by this build: background push delivery is not implemented yet.
# In-app browser notifications work without these.
PUSH_PUBLIC_KEY=
PUSH_PRIVATE_KEY=

# ─── Admin ───────────────────────────────────────────────────────────────────
# Required to view /admin source-health details beyond the public summary.
ADMIN_TOKEN=

# ── Scheduled monitoring (Live research agent → "Monitor this location") ──
# Any long random string. Your scheduler must call GET /api/cron/monitor with
# header "Authorization: Bearer <CRON_SECRET>". vercel.json schedules it daily
# (the Vercel Hobby limit); on Pro, or with an external cron/uptime pinger,
# call it as often as every 15 minutes. Without it, monitors run only on "Run now".
CRON_SECRET=

# Optional: Overpass API endpoint for the Nearby help page (OpenStreetMap data).
OVERPASS_URL=https://overpass-api.de/api/interpreter